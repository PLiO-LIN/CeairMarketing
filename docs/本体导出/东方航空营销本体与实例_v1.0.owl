    <meta:scope xml:lang="zh">本地数据库全部租户的 ontology_entities 与 ontology_relations；不包含线上数据库或未投影的业务记录。</meta:scope>
    <rdfs:comment xml:lang="zh">离线评审快照。IRI 使用保留示例域名，仅作标识，不要求联网。动作、函数及智能域契约为注释，不是可执行 OWL 推理规则。属性原定义不含严格数据类型、必填或基数约束，因此不擅自添加。</rdfs:comment>
    <meta:tenantManifestJson>[{"code":"CEA-HQ","created_at":"2026-08-25 06:42:58.295518","id":1,"name":"东航营销运营中心","status":"active"}]</meta:tenantManifestJson>
    <meta:registryJson>{"actions":[{"changes":["Opportunity.status","HumanDecision"],"id":"confirm_opportunity","name":"确认营销机会","requires":["Opportunity","Evidence"]},{"changes":["MarketingObjective","HumanDecision"],"id":"set_marketing_objective","name":"设定营销目标","requires":["Opportunity","MetricObservation"]},{"changes":["AudienceSnapshot"],"id":"create_audience_snapshot","name":"创建客群快照","requires":["CustomerAggregate"]},{"changes":["Recommendation.status","HumanDecision"],"id":"accept_product_match","name":"确认产品匹配","requires":["AudienceSnapshot","ProductPackage"]},{"changes":["StrategyPlan.status","HumanDecision"],"id":"approve_strategy_plan","name":"确认营销策略方案","requires":["MarketingObjective","AudienceSnapshot","ValueProposition","ProductPackage"]},{"changes":["TouchpointPlan.status"],"id":"publish_touchpoint_plan","name":"发布触点计划","requires":["StrategyPlan","BusinessRule"]},{"changes":["ContentAsset"],"id":"generate_content_draft","name":"生成内容草稿","requires":["CampaignVersion","ProductPackage","AudienceSnapshot"]},{"changes":["ApprovalTask.status"],"id":"submit_campaign_approval","name":"提交活动审批","requires":["CampaignVersion","ContentAsset"]},{"changes":["CampaignVersion.status","HumanDecision"],"id":"approve_campaign","name":"审批活动版本","requires":["ApprovalTask","Evidence"]},{"changes":["ExecutionBatch"],"id":"schedule_execution","name":"安排渠道执行","requires":["CampaignVersion","AudienceSnapshot"]},{"changes":["ExecutionBatch.status"],"id":"pause_execution","name":"暂停触达执行","requires":["ExecutionBatch"]},{"changes":["Review.status","Recommendation"],"id":"complete_review","name":"完成效果复盘","requires":["Campaign","Feedback"]},{"changes":["AttributionResult.status","HumanDecision"],"id":"confirm_attribution","name":"确认营销归因","requires":["AttributionResult","Evidence"]},{"changes":["HumanDecision","BusinessRule"],"id":"accept_agent_recommendation","name":"采纳智能体建议","requires":["Recommendation","Evidence"]}],"agent_contracts":{"activity-orchestration":{"functions":["optimize_touchpoint_mix","check_contact_frequency"],"reads":["Opportunity","MarketingObjective","CustomerNeed","AudienceSnapshot","ValueProposition","ProductPackage","BusinessRule","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["MarketingCase","StrategyPlan","TouchpointPlan","Campaign","CampaignVersion","ExecutionBatch","Recommendation"]},"audience-insight":{"functions":["calculate_audience_size","evaluate_target_attractiveness","calculate_customer_value","check_contact_frequency"],"reads":["CustomerAggregate","CustomerNeed","ConfigurableAttribute","Feedback","MetricObservation","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["AudienceSnapshot","Recommendation","Evidence"]},"content-generation":{"functions":["check_content_facts"],"reads":["CustomerNeed","AudienceSnapshot","ValueProposition","ProductPackage","StrategyPlan","TouchpointPlan","CampaignVersion","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["ContentAsset","Recommendation","Evidence"]},"effect-analysis":{"functions":["calculate_incremental_effect","calculate_campaign_effect","detect_business_anomaly"],"reads":["MarketingObjective","StrategyPlan","TouchpointPlan","Campaign","ExecutionBatch","Feedback","AttributionResult","MetricObservation","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["AttributionResult","Review","Recommendation","Evidence"]},"opportunity-insight":{"functions":["calculate_opportunity_score","detect_business_anomaly"],"reads":["MarketSignal","MetricObservation","Route","Flight","Review","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["Opportunity","MarketingObjective","CustomerNeed","Recommendation","Evidence"]},"product-match":{"functions":["compose_value_proposition","evaluate_product_eligibility","validate_connection_time"],"reads":["Opportunity","CustomerNeed","AudienceSnapshot","Product","ProductPackage","ValueProposition","Flight","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["ValueProposition","Recommendation","Evidence"]}},"functions":[{"id":"calculate_opportunity_score","name":"计算机会评分","reads":["MarketSignal","MetricObservation","Route","Review"],"returns":"Opportunity"},{"id":"evaluate_target_attractiveness","name":"评估目标客群吸引力","reads":["CustomerAggregate","CustomerNeed","MetricObservation","Review"],"returns":"Recommendation"},{"id":"calculate_customer_value","name":"计算客户长期价值","reads":["CustomerAggregate","Feedback","MetricObservation"],"returns":"MetricObservation"},{"id":"compose_value_proposition","name":"生成价值主张","reads":["CustomerNeed","AudienceSnapshot","ProductPackage","Opportunity"],"returns":"ValueProposition"},{"id":"calculate_audience_size","name":"计算客群规模","reads":["CustomerAggregate","AudienceSnapshot"],"returns":"MetricObservation"},{"id":"evaluate_product_eligibility","name":"校验产品资格","reads":["AudienceSnapshot","ProductPackage","BusinessRule"],"returns":"Recommendation"},{"id":"validate_connection_time","name":"校验中转衔接时间","reads":["Flight","Airport","BusinessRule"],"returns":"Recommendation"},{"id":"check_contact_frequency","name":"校验触达频控","reads":["AudienceSnapshot","ExecutionBatch","BusinessRule"],"returns":"Recommendation"},{"id":"optimize_touchpoint_mix","name":"优化触点组合","reads":["StrategyPlan","TouchpointPlan","Channel","Feedback","BusinessRule"],"returns":"Recommendation"},{"id":"check_content_facts","name":"校验内容事实","reads":["ContentAsset","ProductPackage","BusinessRule"],"returns":"Recommendation"},{"id":"calculate_campaign_effect","name":"计算活动效果","reads":["Campaign","ExecutionBatch","Feedback","MetricObservation"],"returns":"Review"},{"id":"calculate_incremental_effect","name":"计算增量效果与归因","reads":["StrategyPlan","Campaign","ExecutionBatch","Feedback","MetricObservation"],"returns":"AttributionResult"},{"id":"detect_business_anomaly","name":"识别经营异常","reads":["MetricObservation","Route","Flight","Review"],"returns":"Recommendation"}],"lifecycle":["data","opportunity","objective","audience","value","product","strategy","content","approval","execution","feedback","attribution","review"],"object_types":[{"attributes":["signal_type","topic","occurred_at","source","confidence"],"description":"来自舆情、搜索热度、节假日和市场趋势的可追溯信号。","id":"MarketSignal","module":"data","name":"市场信号"},{"attributes":["market_scope","region","country_region","season","status"],"description":"国内、国际及地区、区域和目的地市场。","id":"Market","module":"aviation","name":"市场"},{"attributes":["airport_code","city","country_region","airport_type","status"],"description":"起降、中转和地面服务相关的机场对象。","id":"Airport","module":"aviation","name":"机场"},{"attributes":["route_code","origin","destination","market_scope","distance_km"],"description":"由出发地、目的地和市场范围定义的航线经营对象。","id":"Route","module":"aviation","name":"航线"},{"attributes":["flight_no","flight_date","route_code","departure_time","operation_status"],"description":"具体航班、航段、航班计划和运行状态。","id":"Flight","module":"aviation","name":"航班"},{"attributes":["label_code","label_name","source_system","value_type","status"],"description":"Configurable label maintained by the product management platform.","id":"ProductLabel","module":"product","name":"Product label"},{"attributes":["group_code","group_name","category","product_count","status"],"description":"Product management grouping for sellable activity products.","id":"ProductGroup","module":"product","name":"Product group"},{"attributes":["flight_no","origin","destination","departure_at","arrival_at"],"description":"A single itinerary leg with airline, flight number, airports and schedule.","id":"FlightSegment","module":"aviation","name":"Flight segment"},{"attributes":["cabin_code","inventory","available_seats","fare_basis","status"],"description":"Sellable cabin code and inventory level on a flight.","id":"Cabin","module":"aviation","name":"Cabin"},{"attributes":["fare_basis","price","passenger_type","refund_rule","change_rule"],"description":"Fare option with passenger type, taxes, price, change rules and product references.","id":"Fare","module":"product","name":"Fare"},{"attributes":["product_code","service_type","price","availability","validity"],"description":"Optional service such as baggage, seat, lounge, insurance or Wi-Fi.","id":"AncillaryProduct","module":"product","name":"Ancillary product"},{"attributes":["metric_code","metric_value","unit","observed_at","source"],"description":"客座率、正常率、库存、价格和营销指标的带时间观测值。","id":"MetricObservation","module":"aviation","name":"经营指标观测"},{"attributes":["opportunity_type","signal_ids","route_id","target_need","score","status"],"description":"基于事实、信号和规则形成的可经营机会候选或确认机会。","id":"Opportunity","module":"marketing","name":"营销机会"},{"attributes":["objective_type","target_value","measurement_window","owner","status"],"description":"将航线增收、客座率提升、辅营增长、会员活跃或客户保留转化为可衡量目标。","id":"MarketingObjective","module":"marketing","name":"营销目标"},{"attributes":["need_type","journey_stage","price_sensitivity","service_preference","evidence"],"description":"客户在搜索、预订、出行和服务阶段需要解决的价格、便捷、确定性、舒适或权益诉求。","id":"CustomerNeed","module":"customer","name":"客户需求"},{"attributes":["audience_type","member_level","travel_frequency","attributes","population"],"description":"不暴露个人明细的ToB或ToC聚合客户对象。","id":"CustomerAggregate","module":"customer","name":"客户聚合"},{"attributes":["attribute_code","attribute_name","value_type","source","validity"],"description":"可复用源系统标签、运营属性或智能体建议，不预置具体标签值。","id":"ConfigurableAttribute","module":"semantic","name":"可配置业务属性"},{"attributes":["snapshot_code","segment_id","selection_logic","population","frozen_at"],"description":"用于一次活动的可计算、可触达客群版本。","id":"AudienceSnapshot","module":"customer","name":"客群快照"},{"attributes":["product_code","product_type","price","eligibility","validity"],"description":"机票、运价、联运、辅营、卡券和会员权益等营销可用产品。","id":"Product","module":"product","name":"活动产品"},{"attributes":["package_code","version","components","eligibility","approval_status"],"description":"可被活动引用的产品和权益组合版本。","id":"ProductPackage","module":"product","name":"产品包"},{"attributes":["proposition","target_need","differentiator","evidence_ids","status"],"description":"针对目标客群和具体出行需求，说明产品包能够提供的核心利益和差异化理由。","id":"ValueProposition","module":"strategy","name":"价值主张"},{"attributes":["plan_code","objective_id","audience_id","product_package_id","budget","frequency_rule"],"description":"连接机会、目标、客群、价值主张、产品包、预算、节奏和衡量指标的可审批方案。","id":"StrategyPlan","module":"strategy","name":"营销策略方案"},{"attributes":["channel","trigger","time_window","frequency_limit","content_id"],"description":"按旅程阶段定义渠道、触发条件、时间窗口、频次和内容版本的执行计划。","id":"TouchpointPlan","module":"strategy","name":"触点计划"},{"attributes":["content_id","channel","title","body","version","compliance_status"],"description":"面向不同渠道的内容草稿、版本和事实依据。","id":"ContentAsset","module":"marketing","name":"营销内容"},{"attributes":["case_code","opportunity_id","owner","stage","status"],"description":"贯穿机会、客群、产品、活动、执行和复盘的业务主线。","id":"MarketingCase","module":"marketing","name":"营销经营事项"},{"attributes":["campaign_id","name","objective","budget","owner","status"],"description":"面向执行的营销活动及其业务目标、预算和状态。","id":"Campaign","module":"marketing","name":"营销活动"},{"attributes":["version","audience_snapshot_id","product_package_id","content_asset_ids","channels","status"],"description":"活动方案在客群、产品、内容、渠道或预算变化后的可追溯版本。","id":"CampaignVersion","module":"marketing","name":"活动版本"},{"attributes":["approval_type","approver_role","decision","comment","decided_at"],"description":"营销运营、预算、产品和合规等多级审批节点。","id":"ApprovalTask","module":"governance","name":"审批任务"},{"attributes":["batch_code","channel","target_count","sent_count","status"],"description":"按渠道、时间窗口和客群快照生成的触达执行批次。","id":"ExecutionBatch","module":"execution","name":"执行批次"},{"attributes":["channel_code","channel_type","provider","consent_required","status"],"description":"东航App、微信、短信、官网、企业和分销触点。","id":"Channel","module":"execution","name":"触达渠道"},{"attributes":["delivered_count","clicked_count","converted_count","unsubscribe_count","complaint_count"],"description":"送达、打开、点击、出票、辅营、退订和投诉等反馈。","id":"Feedback","module":"execution","name":"营销反馈"},{"attributes":["attribution_model","incremental_orders","incremental_revenue","roi","confidence"],"description":"将增量出票、辅营收入、会员活跃和服务反馈归因到客群、产品、内容、渠道及策略。","id":"AttributionResult","module":"measurement","name":"营销归因结果"},{"attributes":["review_period","conclusion","key_findings","next_action","status"],"description":"对活动目标、渠道、客群、产品和内容效果的复盘结论。","id":"Review","module":"marketing","name":"效果复盘"},{"attributes":["recommendation_type","reasoning","confidence","status","confirmed_by"],"description":"由智能体基于事实和关系生成、等待人工确认的业务建议。","id":"Recommendation","module":"agent","name":"营销建议"},{"attributes":["rule_type","expression","priority","effective_period","status"],"description":"MCT、库存、频控、保护、资格、预算和合规规则。","id":"BusinessRule","module":"governance","name":"业务规则"},{"attributes":["source_type","source_ref","excerpt","captured_at","confidence"],"description":"支撑事实、推断、建议和人工决策的来源记录。","id":"Evidence","module":"governance","name":"业务证据"},{"attributes":["decision_type","operator","decision","comment","decided_at"],"description":"对智能体建议、活动版本和审批节点的确认、修改或驳回。","id":"HumanDecision","module":"governance","name":"人工决策"},{"attributes":["domain_id","input_context","output_summary","status","created_at"],"description":"智能域读取本体、调用函数并产生候选结果的运行记录。","id":"AgentRun","module":"agent","name":"智能体运行"},{"attributes":["document_id","title","source_name","file_type","version"],"description":"经授权接入的航班、运价、产品、营销和运营文档原文。","id":"KnowledgeDocument","module":"knowledge","name":"知识文档"},{"attributes":["document_id","page_no","paragraph_no","content_hash"],"description":"文档切分后的可检索片段，保留页码、段落和来源定位。","id":"KnowledgeChunk","module":"knowledge","name":"知识片段"},{"attributes":["claim_type","subject_id","predicate","object_id","confidence"],"description":"从文档或数据中提取的待核验事实，连接原文证据与本体对象。","id":"KnowledgeClaim","module":"knowledge","name":"知识事实"}],"principles":["本体建模真实航空营销业务对象，不复制源系统表结构。","标签作为对象的可配置业务属性，可复用已有系统标签，也可由运营或智能体产生。","智能体输出先形成候选事实、推断或建议，人工通过业务动作确认后再进入正式流程。","每个判断保留来源、证据、置信度、有效期、版本和人工决策状态。","知识文档和本体图谱共同构成知识底座：文档保存可追溯内容，本体表达可计算关系。"],"relation_types":[{"from_types":["Route","FlightSegment"],"id":"departs_from","name":"出发机场","to_types":["Airport"]},{"from_types":["Route","FlightSegment"],"id":"arrives_at","name":"到达机场","to_types":["Airport"]},{"from_types":["Flight"],"id":"has_segment","name":"包含航段","to_types":["FlightSegment"]},{"from_types":["Flight"],"id":"operates_on","name":"执飞航线","to_types":["Route"]},{"from_types":["Flight","FlightSegment"],"id":"has_cabin","name":"提供舱位","to_types":["Cabin"]},{"from_types":["Cabin"],"id":"has_fare","name":"提供运价","to_types":["Fare"]},{"from_types":["Fare"],"id":"uses_product","name":"引用产品","to_types":["Product","AncillaryProduct"]},{"from_types":["Product","ProductPackage","Flight","FlightSegment"],"id":"has_product_label","name":"挂接产品标签","to_types":["ProductLabel"]},{"from_types":["Fare","ProductPackage","Product"],"id":"includes_ancillary","name":"包含辅营","to_types":["AncillaryProduct"]},{"from_types":["MarketSignal","MetricObservation","Opportunity","Recommendation","MarketingCase"],"id":"derived_from","name":"来源于","to_types":["Evidence","MarketSignal","MetricObservation","Review"]},{"from_types":["MarketSignal","Opportunity","Campaign","MarketingCase"],"id":"concerns_route","name":"涉及航线","to_types":["Route"]},{"from_types":["Opportunity","Campaign","MarketingCase"],"id":"concerns_flight","name":"涉及航班","to_types":["Flight"]},{"from_types":["Route","Flight","Campaign","ExecutionBatch","ProductPackage"],"id":"has_metric","name":"具有指标","to_types":["MetricObservation"]},{"from_types":["AgentRun","MarketingCase"],"id":"identifies","name":"识别出","to_types":["Opportunity","Recommendation"]},{"from_types":["Opportunity","Campaign","MarketingCase","ProductPackage","StrategyPlan"],"id":"targets_audience","name":"面向客群","to_types":["AudienceSnapshot","CustomerAggregate"]},{"from_types":["Opportunity","AudienceSnapshot","CustomerAggregate"],"id":"reveals_need","name":"揭示需求","to_types":["CustomerNeed"]},{"from_types":["MarketingCase","Campaign","StrategyPlan"],"id":"pursues_objective","name":"承接目标","to_types":["MarketingObjective"]},{"from_types":["Campaign","MarketingCase","AudienceSnapshot","StrategyPlan"],"id":"uses_product_package","name":"使用产品包","to_types":["ProductPackage"]},{"from_types":["ProductPackage"],"id":"contains_product","name":"包含产品","to_types":["Product"]},{"from_types":["Product"],"id":"belongs_to_product_group","name":"属于产品组","to_types":["ProductGroup"]},{"from_types":["Campaign","MarketingCase","ProductPackage","StrategyPlan"],"id":"addresses_opportunity","name":"响应机会","to_types":["Opportunity"]},{"from_types":["ValueProposition","ProductPackage"],"id":"satisfies_need","name":"满足需求","to_types":["CustomerNeed"]},{"from_types":["StrategyPlan","CampaignVersion"],"id":"defines_value","name":"定义价值主张","to_types":["ValueProposition"]},{"from_types":["MarketingCase","Campaign"],"id":"has_strategy_plan","name":"包含策略方案","to_types":["StrategyPlan"]},{"from_types":["StrategyPlan","CampaignVersion"],"id":"uses_touchpoint_plan","name":"使用触点计划","to_types":["TouchpointPlan"]},{"from_types":["CampaignVersion","AgentRun","MarketingCase"],"id":"generates_content","name":"生成内容","to_types":["ContentAsset"]},{"from_types":["Campaign","MarketingCase"],"id":"has_campaign_version","name":"包含活动版本","to_types":["CampaignVersion"]},{"from_types":["CampaignVersion","Campaign"],"id":"requires_approval","name":"需要审批","to_types":["ApprovalTask"]},{"from_types":["Campaign","CampaignVersion","MarketingCase"],"id":"executes","name":"产生执行","to_types":["ExecutionBatch"]},{"from_types":["ExecutionBatch","CampaignVersion","TouchpointPlan"],"id":"uses_channel","name":"使用渠道","to_types":["Channel"]},{"from_types":["TouchpointPlan","ExecutionBatch"],"id":"carries_content","name":"承载内容","to_types":["ContentAsset"]},{"from_types":["ExecutionBatch","Campaign"],"id":"produces_feedback","name":"产生反馈","to_types":["Feedback"]},{"from_types":["Campaign","ExecutionBatch","StrategyPlan"],"id":"produces_attribution","name":"形成归因","to_types":["AttributionResult"]},{"from_types":["AttributionResult"],"id":"attributes_to","name":"归因到","to_types":["Campaign","StrategyPlan","AudienceSnapshot","ProductPackage","ContentAsset","Channel"]},{"from_types":["Campaign","MarketingCase","AttributionResult"],"id":"reviewed_by","name":"由复盘形成","to_types":["Review"]},{"from_types":["Review","AgentRun"],"id":"generates_recommendation","name":"形成建议","to_types":["Recommendation"]},{"from_types":["Review","Recommendation"],"id":"updates_rule","name":"更新规则建议","to_types":["BusinessRule"]},{"from_types":["Recommendation","Opportunity","CampaignVersion","AudienceSnapshot"],"id":"confirmed_by_human","name":"经人工确认","to_types":["HumanDecision"]},{"from_types":["Opportunity","Recommendation","HumanDecision","MetricObservation"],"id":"has_evidence","name":"具有证据","to_types":["Evidence"]},{"from_types":["CustomerAggregate","AudienceSnapshot","Route","Flight","Product","ProductPackage","Campaign"],"id":"has_tag_attribute","name":"具有可配置属性","to_types":["ConfigurableAttribute"]},{"from_types":["KnowledgeDocument"],"id":"contains_chunk","name":"包含片段","to_types":["KnowledgeChunk"]},{"from_types":["KnowledgeChunk","Evidence"],"id":"supports_claim","name":"支撑事实","to_types":["KnowledgeClaim","Opportunity","Recommendation","BusinessRule"]},{"from_types":["KnowledgeChunk","Evidence"],"id":"evidence_for","name":"提供业务证据","to_types":["Evidence","MarketSignal","Market","Airport","Route","Flight","MetricObservation","Opportunity","MarketingObjective","CustomerNeed","CustomerAggregate","AudienceSnapshot","Product","ProductPackage","ValueProposition","StrategyPlan","TouchpointPlan","ContentAsset","MarketingCase","Campaign","CampaignVersion","ApprovalTask","ExecutionBatch","Feedback","AttributionResult","Review","Recommendation","BusinessRule"]},{"from_types":["KnowledgeClaim"],"id":"claims_about","name":"描述对象","to_types":["Market","Airport","Route","Flight","MetricObservation","Product","ProductPackage","BusinessRule","Opportunity","MarketingObjective","CustomerNeed","ValueProposition","StrategyPlan","TouchpointPlan","AttributionResult"]}],"version":"ceair-marketing-ontology-v1.1"}</meta:registryJson>
    <meta:lifecycleJson>["data","opportunity","objective","audience","value","product","strategy","content","approval","execution","feedback","attribution","review"]</meta:lifecycleJson>
    <meta:principle xml:lang="zh">本体建模真实航空营销业务对象，不复制源系统表结构。</meta:principle>
    <meta:principle xml:lang="zh">标签作为对象的可配置业务属性，可复用已有系统标签，也可由运营或智能体产生。</meta:principle>
    <meta:principle xml:lang="zh">智能体输出先形成候选事实、推断或建议，人工通过业务动作确认后再进入正式流程。</meta:principle>
    <meta:principle xml:lang="zh">每个判断保留来源、证据、置信度、有效期、版本和人工决策状态。</meta:principle>
    <meta:principle xml:lang="zh">知识文档和本体图谱共同构成知识底座：文档保存可追溯内容，本体表达可计算关系。</meta:principle>
    <meta:actionDefinition>{"changes":["Opportunity.status","HumanDecision"],"id":"confirm_opportunity","name":"确认营销机会","requires":["Opportunity","Evidence"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["MarketingObjective","HumanDecision"],"id":"set_marketing_objective","name":"设定营销目标","requires":["Opportunity","MetricObservation"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["AudienceSnapshot"],"id":"create_audience_snapshot","name":"创建客群快照","requires":["CustomerAggregate"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["Recommendation.status","HumanDecision"],"id":"accept_product_match","name":"确认产品匹配","requires":["AudienceSnapshot","ProductPackage"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["StrategyPlan.status","HumanDecision"],"id":"approve_strategy_plan","name":"确认营销策略方案","requires":["MarketingObjective","AudienceSnapshot","ValueProposition","ProductPackage"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["TouchpointPlan.status"],"id":"publish_touchpoint_plan","name":"发布触点计划","requires":["StrategyPlan","BusinessRule"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["ContentAsset"],"id":"generate_content_draft","name":"生成内容草稿","requires":["CampaignVersion","ProductPackage","AudienceSnapshot"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["ApprovalTask.status"],"id":"submit_campaign_approval","name":"提交活动审批","requires":["CampaignVersion","ContentAsset"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["CampaignVersion.status","HumanDecision"],"id":"approve_campaign","name":"审批活动版本","requires":["ApprovalTask","Evidence"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["ExecutionBatch"],"id":"schedule_execution","name":"安排渠道执行","requires":["CampaignVersion","AudienceSnapshot"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["ExecutionBatch.status"],"id":"pause_execution","name":"暂停触达执行","requires":["ExecutionBatch"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["Review.status","Recommendation"],"id":"complete_review","name":"完成效果复盘","requires":["Campaign","Feedback"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["AttributionResult.status","HumanDecision"],"id":"confirm_attribution","name":"确认营销归因","requires":["AttributionResult","Evidence"]}</meta:actionDefinition>
    <meta:actionDefinition>{"changes":["HumanDecision","BusinessRule"],"id":"accept_agent_recommendation","name":"采纳智能体建议","requires":["Recommendation","Evidence"]}</meta:actionDefinition>
    <meta:functionDefinition>{"id":"calculate_opportunity_score","name":"计算机会评分","reads":["MarketSignal","MetricObservation","Route","Review"],"returns":"Opportunity"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"evaluate_target_attractiveness","name":"评估目标客群吸引力","reads":["CustomerAggregate","CustomerNeed","MetricObservation","Review"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"calculate_customer_value","name":"计算客户长期价值","reads":["CustomerAggregate","Feedback","MetricObservation"],"returns":"MetricObservation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"compose_value_proposition","name":"生成价值主张","reads":["CustomerNeed","AudienceSnapshot","ProductPackage","Opportunity"],"returns":"ValueProposition"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"calculate_audience_size","name":"计算客群规模","reads":["CustomerAggregate","AudienceSnapshot"],"returns":"MetricObservation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"evaluate_product_eligibility","name":"校验产品资格","reads":["AudienceSnapshot","ProductPackage","BusinessRule"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"validate_connection_time","name":"校验中转衔接时间","reads":["Flight","Airport","BusinessRule"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"check_contact_frequency","name":"校验触达频控","reads":["AudienceSnapshot","ExecutionBatch","BusinessRule"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"optimize_touchpoint_mix","name":"优化触点组合","reads":["StrategyPlan","TouchpointPlan","Channel","Feedback","BusinessRule"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"check_content_facts","name":"校验内容事实","reads":["ContentAsset","ProductPackage","BusinessRule"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"calculate_campaign_effect","name":"计算活动效果","reads":["Campaign","ExecutionBatch","Feedback","MetricObservation"],"returns":"Review"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"calculate_incremental_effect","name":"计算增量效果与归因","reads":["StrategyPlan","Campaign","ExecutionBatch","Feedback","MetricObservation"],"returns":"AttributionResult"}</meta:functionDefinition>
    <meta:functionDefinition>{"id":"detect_business_anomaly","name":"识别经营异常","reads":["MetricObservation","Route","Flight","Review"],"returns":"Recommendation"}</meta:functionDefinition>
    <meta:agentContract>{"functions":["calculate_opportunity_score","detect_business_anomaly"],"id":"opportunity-insight","name":"机会洞察智能域","reads":["MarketSignal","MetricObservation","Route","Flight","Review","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["Opportunity","MarketingObjective","CustomerNeed","Recommendation","Evidence"]}</meta:agentContract>
    <meta:agentContract>{"functions":["calculate_audience_size","evaluate_target_attractiveness","calculate_customer_value","check_contact_frequency"],"id":"audience-insight","name":"客群洞察智能域","reads":["CustomerAggregate","CustomerNeed","ConfigurableAttribute","Feedback","MetricObservation","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["AudienceSnapshot","Recommendation","Evidence"]}</meta:agentContract>
    <meta:agentContract>{"functions":["compose_value_proposition","evaluate_product_eligibility","validate_connection_time"],"id":"product-match","name":"产品匹配智能域","reads":["Opportunity","CustomerNeed","AudienceSnapshot","Product","ProductPackage","ValueProposition","Flight","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["ValueProposition","Recommendation","Evidence"]}</meta:agentContract>
    <meta:agentContract>{"functions":["optimize_touchpoint_mix","check_contact_frequency"],"id":"activity-orchestration","name":"活动编排智能域","reads":["Opportunity","MarketingObjective","CustomerNeed","AudienceSnapshot","ValueProposition","ProductPackage","BusinessRule","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["MarketingCase","StrategyPlan","TouchpointPlan","Campaign","CampaignVersion","ExecutionBatch","Recommendation"]}</meta:agentContract>
    <meta:agentContract>{"functions":["check_content_facts"],"id":"content-generation","name":"内容生成智能域","reads":["CustomerNeed","AudienceSnapshot","ValueProposition","ProductPackage","StrategyPlan","TouchpointPlan","CampaignVersion","BusinessRule","KnowledgeChunk","KnowledgeClaim"],"writes":["ContentAsset","Recommendation","Evidence"]}</meta:agentContract>
    <meta:agentContract>{"functions":["calculate_incremental_effect","calculate_campaign_effect","detect_business_anomaly"],"id":"effect-analysis","name":"效果分析智能域","reads":["MarketingObjective","StrategyPlan","TouchpointPlan","Campaign","ExecutionBatch","Feedback","AttributionResult","MetricObservation","HumanDecision","KnowledgeChunk","KnowledgeClaim"],"writes":["AttributionResult","Review","Recommendation","Evidence"]}</meta:agentContract>
  </rdf:Description>
