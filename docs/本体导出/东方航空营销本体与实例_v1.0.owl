  <rdf:Description rdf:about="https://ceair.example/ontology/marketing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="zh">东方航空营销本体与实例 v1.0</rdfs:label>
    <owl:versionInfo>v1.0</owl:versionInfo>
